diff --git a/tools/ars510_validation/native/test_actuator_bounds.py b/tools/ars510_validation/native/test_actuator_bounds.py
new file mode 100644
index 0000000..2c24083
--- /dev/null
+++ b/tools/ars510_validation/native/test_actuator_bounds.py
@@ -0,0 +1,71 @@
+"""실제 native MPC를 사용한 차량 명령 한계와 기존 경로 보존 회귀."""
+from pathlib import Path
+import sys
+
+import numpy as np
+import pytest
+
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(REPO_ROOT.parent / "native_sim"))
+from offline_io import prepare
+
+prepare(solver_overlay=True)
+from opendbc.car import gen_empty_fingerprint
+from opendbc.car.toyota.interface import CarInterface
+from opendbc.car.toyota.values import CAR
+from openpilot.cereal import log
+from openpilot.selfdrive.controls.lib.longitudinal_mpc_lib.long_mpc import ACCEL_MIN, LongitudinalMpc
+from openpilot.selfdrive.controls.lib.longitudinal_planner import LongitudinalPlanner
+
+
+def cp(platform=CAR.TOYOTA_RAV4_TSS2_2022, direct=True):
+  return CarInterface.get_params(platform, gen_empty_fingerprint(), [], direct, False, False)
+
+
+@pytest.mark.parametrize("bad", [
+  (), (0.0, 2.0), (-3.5, 0.0), (1.0, 2.0), (-3.5, -1.0), (-4.1, 2.0), (-3.5, 2.6),
+  (np.nan, 2.0), (-3.5, np.inf), (-np.inf, 2.0), (False, 2.0), (-3.5, True),
+  (-3.5, np.bool_(True)), ("not a number", 2.0), (-3.5,), (-3.5, 2.0, 3.0), 0,
+])
+def test_invalid_envelope_refuses_solver_setup(bad):
+  with pytest.raises(ValueError):
+    LongitudinalMpc(actuator_accel_limits=bad)
+
+
+def test_original_constructor_and_cruise_policy_are_preserved():
+  mpc = LongitudinalMpc()
+  assert mpc.actuator_accel_limits is None and mpc.minimum_accel == ACCEL_MIN
+  mpc.set_accel_limits(-2.0, 3.0)
+  assert mpc.cruise_min_a == -2.0 and mpc.max_a == 3.0
+
+
+def test_rav4_source_envelope_restricts_actual_native_parameters():
+  planner = LongitudinalPlanner(cp())
+  assert planner.actuator_accel_limits == (-3.5, 2.0)
+  assert planner.mpc.minimum_accel == -3.5
+  planner.mpc.set_accel_limits(-2.0, 2.5)
+  assert planner.mpc.cruise_min_a == -2.0 and planner.mpc.max_a == 2.0
+  # 존재하는 정지 객체의 불가능한 초기 거리에는 원형 수렴 floor를 같은 명령 하한으로 계산한다.
+  planner.mpc.set_cur_state(25.0, 0.0)
+  lead = log.RadarState.LeadData(status=True, dRel=1.0, vLead=0.0, vLeadK=0.0)
+  extrapolated, _ = planner.mpc.process_lead(lead)
+  assert extrapolated[0, 0] == pytest.approx(25.0**2 / (4.0*3.5))
+  assert type(planner.mpc.solver).__name__ == "AcadosOcpSolverCython"
+
+
+@pytest.mark.parametrize("platform,direct", [
+  (CAR.TOYOTA_RAV4_TSS2_2022, False), (CAR.TOYOTA_RAV4_TSS2_2023, True),
+  (CAR.TOYOTA_RAV4_TSS2, True), (CAR.TOYOTA_CHR_TSS2, True),
+])
+def test_other_vehicle_or_stock_long_keeps_legacy_limits(platform, direct):
+  planner = LongitudinalPlanner(cp(platform, direct))
+  assert planner.actuator_accel_limits is None and planner.mpc.minimum_accel == ACCEL_MIN
+
+
+@pytest.mark.parametrize("bad", [None, (-4.5, 2.0), (-3.5, 0.0), (np.nan, 2.0)])
+def test_invalid_toyota_public_interface_result_is_not_guessed(monkeypatch, bad):
+  params = cp()
+  monkeypatch.setattr(CarInterface, "get_pid_accel_limits", lambda *args: bad)
+  with pytest.raises(ValueError):
+    LongitudinalPlanner(params)
