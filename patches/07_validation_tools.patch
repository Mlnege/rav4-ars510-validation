+"""저장된 원형 신호·종방향 계산 결과만 요약하고 정적 그림을 만든다."""
+
+import argparse
+from collections import defaultdict
+import csv
+from datetime import UTC, datetime
+import json
+from pathlib import Path
+
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+from matplotlib import font_manager
+
+
+def rows_by_case(path):
+  cases = defaultdict(list)
+  with path.open(encoding='utf-8', newline='') as stream:
+    for row in csv.DictReader(stream):
+      if row.get('cycle') != '0' or row.get('violations') is None:
+        continue
+      cases[row['case']].append(row)
+  return cases
+
+
+def number(rows, key):
+  return [float(row[key]) for row in rows]
+
+
+def boolean(rows, key):
+  return [int(row[key] == 'True') for row in rows]
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--trace', type=Path, required=True)
+  parser.add_argument('--output', type=Path, required=True)
+  args = parser.parse_args()
+  args.output.mkdir(parents=True, exist_ok=True)
+  # 그림의 한국어 글꼴만 읽는다. 운영 설정이나 시스템 글꼴을 설치하지 않는다.
+  for path in ('/mnt/c/Windows/Fonts/malgun.ttf', 'C:/Windows/Fonts/malgun.ttf'):
+    if Path(path).exists():
+      font_manager.fontManager.addfont(path)
+      plt.rcParams['font.family'] = font_manager.FontProperties(fname=path).get_name()
+      break
+  plt.rcParams.update({'axes.unicode_minus': False, 'font.size': 10, 'axes.spines.top': False, 'axes.spines.right': False})
+  cases = rows_by_case(args.trace)
+  selected = ('mode2_moving_red', 'mode2_model_red_stop', 'mode2_can_fault', 'green_keeps_model_stop')
+  assert all(len(cases[key]) == 240 for key in selected), '첫 시나리오 주기가 아직 완성되지 않았습니다'
+  figure, axes = plt.subplots(2, 2, figsize=(13, 8), constrained_layout=True)
+  titles = ('빨간 신호 정지 준비: 완만한 감속', '원형 모델 정지: 더 강한 제동 우선',
+            '5~6초 CAN 입력 오류: 실제 제어 출력 0', '5초 이후 초록: 원형 정지 판단 유지')
+  report = {}
+  for index, (axis, case, title) in enumerate(zip(axes.flat, selected, titles, strict=True)):
+    rows = cases[case]
+    x = number(rows, 'case_elapsed')
+    if index < 3:
+      axis.plot(x, number(rows, 'a_target'), color='#174ea6', lw=2, label='계획 가속도 목표')
+      axis.plot(x, number(rows, 'controller_accel'), color='#dc6803', lw=1.5, label='종방향 제어 출력')
+      axis.plot(x, number(rows, 'plant_accel'), color='#667085', lw=1.5, label='단순 차량 모형 응답')
+      axis.set_ylabel('가속도 (m/s²)')
+      if index == 0:
+        axis.axhline(-.5, color='#b42318', ls='--', lw=1, label='정지 준비 감속 -0.5')
+      if index == 2:
+        axis.axvspan(5, 6, color='#fee4e2', alpha=.8, label='CAN 유효성 오류')
+    else:
+      axis.step(x, boolean(rows, 'start_hold'), where='post', color='#b42318', lw=2, label='신호 출발 금지')
+      axis.step(x, boolean(rows, 'should_stop'), where='post', color='#174ea6', lw=2, ls='--', label='원형 모델 포함 정지 판단')
+      axis.axvspan(5, 12, color='#d1fadf', alpha=.5, label='합성 초록 관측')
+      axis.set_ylabel('조건 성립 여부 (0/1)')
+      axis.set_ylim(-.08, 1.18)
+    axis.set_title(title, loc='left', fontsize=12)
+    axis.set_xlabel('시나리오 시작 후 시간 (초)')
+    axis.set_xlim(0, 12)
+    axis.grid(axis='y', alpha=.2)
+    axis.legend(loc='best', frameon=False, fontsize=9)
+    active = [row for row in rows if row['prepare_control'] == 'True']
+    negative = [row for row in rows if float(row['a_target']) < 0]
+    released = [row for row in rows if row['start_released'] == 'True']
+    report[case] = {'plan_count': len(rows), 'control_count': sum(int(row['control_updates']) for row in rows),
+                    'first_prepare_seconds': float(active[0]['case_elapsed']) if active else None,
+                    'first_negative_target_seconds': float(negative[0]['case_elapsed']) if negative else None,
+                    'minimum_target_mps2': min(number(rows, 'a_target')),
+                    'first_green_release_seconds': float(released[0]['case_elapsed']) if released else None,
+                    'solver_errors': sum(row['solver_status'] != '0' for row in rows)}
+  figure.suptitle('OX03C10 좌표 계약 · 실제 계획/제어 코드의 오프라인 신호 시험\n' +
+                  '합성 신호 관측과 단순 지연 차량 모형 사용 · 실물 인식 정확도 및 실차 안전성 미검증', fontsize=14)
+  figure.savefig(args.output/'native_signal_first_cycle.png', dpi=150)
+  plt.close(figure)
+  summary = {'recorded_utc': datetime.now(UTC).isoformat(), 'case_metrics': report,
+             'scope': 'first_complete_synthetic_cycle_actual_native_algorithms',
+             'camera_recognition_verified': False, 'vehicle_verified': False, 'completed_one_hour_claimed': False}
+  (args.output/'native_signal_first_cycle.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding='utf-8')
+  print(json.dumps(summary, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+  main()
diff --git a/tools/ars510_validation/signal/test_native_signal.py b/tools/ars510_validation/signal/test_native_signal.py
new file mode 100644
index 0000000..d2f4ad5
--- /dev/null
+++ b/tools/ars510_validation/signal/test_native_signal.py
@@ -0,0 +1,116 @@
+"""실제 신호 runtime→CarrotPlanner→native MPC→LongControl 인계 검증.
+
+관측·시각·설정·메시지 저장소만 합성한다. 이미지의 색 정확도나 실차 응답
+검사로 해석하면 안 된다. 실제 계산 클래스·solver·최종 제어를 실행한다.
+"""
+
+import pytest
+
+from tools.ars510_validation.signal.native_signal import NativeSignalHarness, ReplayClock, input_clock  # noqa: TID251
+
+
+@pytest.fixture(params=['os04c10', 'ox03c10'])
+def native(request, tmp_path):
+  clock = ReplayClock()
+  with input_clock(clock):
+    harness = NativeSignalHarness(tmp_path, clock=clock, camera_profile=request.param)
+    yield harness
+    assert harness.unchanged_cp()
+
+
+def checked_step(harness, index, **kwargs):
+  row = harness.step(100. + index * .05, **kwargs)
+  assert row['solver_status'] == 0
+  assert row['control_updates'] == 5
+  assert 0 <= row['processing_delay'] <= .2
+  assert -3.5 <= row['a_target'] <= 2.
+  assert -3.5 <= row['controller_accel'] <= 2.
+  return row
+
+
+@pytest.mark.parametrize('mode', [0, 1, 2])
+@pytest.mark.parametrize('latency', [.1, .199, .201, .4, .66, -.01])
+def test_native_moving_signal_mode_and_capture_deadline(native, mode, latency):
+  rows = [checked_step(native, index, signal_mode=mode, latency=latency) for index in range(100)]
+  if mode != 2 or not 0 <= latency <= .2:
+    assert not any(row['prepare_control'] for row in rows)
+  else:
+    assert any(row['prepare_control'] for row in rows)
+    assert min(row['a_target'] for row in rows) >= -.50001
+    assert not any(row['should_stop'] for row in rows)
+  if mode == 0:
+    assert not any(row['prepare'] or row['start_hold'] for row in rows)
+
+
+@pytest.mark.parametrize('fault', ['green', 'unknown', 'gas', 'brake', 'lead', 'can_invalid',
+                                 'session_restart', 'uncalibrated', 'camera_invalid', 'pose_invalid'])
+def test_native_active_prepare_yields_to_fault_and_original_priority(native, fault):
+  before = [checked_step(native, index) for index in range(100)]
+  assert before[-1]['prepare_control']
+  kwargs = {}
+  if fault in ('green', 'unknown'):
+    kwargs['color'] = fault
+  elif fault in ('gas', 'brake', 'lead'):
+    kwargs[fault] = True
+  elif fault == 'can_invalid':
+    kwargs['can_valid'] = False
+  elif fault == 'session_restart':
+    kwargs['session'] = 'restarted'
+  else:
+    # 합성 서비스의 유효성 입력만 바꾸며 read/update 판단은 그대로 실행한다.
+    if fault == 'uncalibrated':
+      native.sm['liveCalibration'].calStatus = 'uncalibrated'
+    elif fault == 'camera_invalid':
+      native.sm.valid['roadCameraState'] = False
+    elif fault == 'pose_invalid':
+      native.sm['livePose'].sensorsOK = False
+  row = checked_step(native, 100, **kwargs)
+  assert not row['prepare_control']
+  if fault in ('gas', 'brake', 'can_invalid'):
+    assert row['controller_accel'] == 0
+  if fault == 'can_invalid':
+    assert not row['plan_valid']
+
+
+def test_native_gentle_prepare_ramp_preserves_two_second_half_meter_target(native):
+  caps = []
+  for index in range(180):
+    row = checked_step(native, index)
+    if row['prepare_control']:
+      caps.append(native.planner._signal_prepare_accel.cap)
+  assert len(caps) > 100 and caps[-1] == -.5
+  for previous, current in zip(caps, caps[1:], strict=False):
+    assert -.5 <= current <= previous
+    assert current - previous >= -.25 * .05 - 1e-8
+
+
+@pytest.mark.parametrize('invalid_color,latency', [('unknown', .1), ('green', .66)])
+def test_native_stopped_red_latch_is_not_released_by_unknown_or_stale_green(native, invalid_color, latency):
+  rows = [checked_step(native, index, signal_mode=1, speed=0., enabled=index >= 40)
+          for index in range(60)]
+  assert rows[-1]['start_hold']
+  for index in range(60, 90):
+    row = checked_step(native, index, signal_mode=1, speed=0., color=invalid_color, latency=latency)
+    assert row['start_hold'] and not row['start_released']
+    assert row['should_stop'] and row['v_target'] == 0 and row['a_target'] <= 0
+
+
+def test_native_confirmed_green_only_removes_veto_and_model_stop_is_preserved(native):
+  rows = [checked_step(native, index, signal_mode=1, speed=0., enabled=index >= 40, model_stop_distance=.1)
+          for index in range(60)]
+  assert rows[-1]['start_hold']
+  green = [checked_step(native, index, signal_mode=1, speed=0., color='green', model_stop_distance=.1)
+           for index in range(60, 100)]
+  released = [row for row in green if row['start_released']]
+  assert len(released) == 1
+  # 동일 하우징의 초록 .7초 확인 전에는 출발 금지가 유지된다.
+  assert released[0]['time'] >= 103.7 - 1e-8
+  assert all(row['should_stop'] for row in green)
+
+
+def test_native_observer_gap_cancels_prepare_without_manufacturing_stop_or_go(native):
+  rows = [checked_step(native, index) for index in range(100)]
+  assert rows[-1]['prepare_control']
+  gap = [checked_step(native, index, publish=False) for index in range(100, 112)]
+  assert not gap[-1]['prepare_control']
+  assert not gap[-1]['should_stop']
