+"""원본 실패와 수정 후 CAN 기록의 차이를 실제 CSV로만 그린다."""
+
+import argparse
+import csv
+import json
+from pathlib import Path
+
+import matplotlib
+matplotlib.use('Agg')
+from matplotlib import font_manager
+import matplotlib.pyplot as plt
+
+
+def load(folder):
+  with (folder/'stopped_red_green_go_can_control.csv').open(encoding='utf-8') as stream:
+    return list(csv.DictReader(stream))
+
+
+def values(rows, key):
+  return [float(row[key]) for row in rows]
+
+
+def metrics(rows):
+  held = [row for row in rows if row['start_hold'] == 'True']
+  positive = [row for row in held if float(row['decoded_acc_command']) > 0]
+  negative = next(row for row in held if float(row['decoded_acc_command']) < 0)
+  return {'positive_held_control_ticks': len(positive),
+          'new_positive_acc_messages_while_held': sum(row['acc_control_created'] == 'True' for row in positive),
+          'first_negative_acc_command_s': float(negative['time'])-100.,
+          'maximum_point_mass_speed_while_held_mps': max(values(held, 'plant_speed')),
+          'point_mass_distance_while_held_m': sum(values(held, 'plant_speed'))*.01,
+          'physical_measurement': False}
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument('--before', type=Path, required=True)
+  parser.add_argument('--after', type=Path, required=True)
+  parser.add_argument('--output', type=Path, required=True)
+  args = parser.parse_args()
+  args.output.mkdir(parents=True, exist_ok=True)
+  for path in ('/mnt/c/Windows/Fonts/malgun.ttf', 'C:/Windows/Fonts/malgun.ttf'):
+    if Path(path).exists():
+      font_manager.fontManager.addfont(path)
+      plt.rcParams['font.family'] = font_manager.FontProperties(fname=path).get_name()
+      break
+  plt.rcParams.update({'axes.unicode_minus': False, 'font.size': 11, 'axes.spines.top': False, 'axes.spines.right': False})
+  before, after = load(args.before), load(args.after)
+  figure, axes = plt.subplots(1, 2, figsize=(13, 5), constrained_layout=True)
+  x_before = [value-100. for value in values(before, 'time')]
+  x_after = [value-100. for value in values(after, 'time')]
+  left, right = axes
+  left.step(x_before, values(before, 'decoded_acc_command'), where='post', color='#b42318', lw=2, label='수정 전 CAN 요청')
+  left.step(x_after, values(after, 'decoded_acc_command'), where='post', color='#175cd3', lw=2, label='수정 후 CAN 요청')
+  left.plot(x_after, values(after, 'longcontrol_output'), color='#667085', ls='--', lw=1.5, label='원형 LongControl 출력')
+  left.set_ylabel('가속도 요청 (m/s²)')
+  left.set_title('첫 정규 메시지에서 양수 요청 제거', loc='left')
+  left.set_ylim(-.25, .85)
+  right.plot(x_before, values(before, 'plant_speed'), color='#b42318', lw=2, label='수정 전 지연 모형 속도')
+  right.plot(x_after, values(after, 'plant_speed'), color='#175cd3', lw=2, label='수정 후 지연 모형 속도')
+  right.set_ylabel('가상 차량 속도 (m/s)')
+  right.set_title('기존 요청·확인·응답 지연의 영향은 남음', loc='left')
+  right.set_ylim(-.003, .09)
+  for axis in axes:
+    axis.axvline(2.15, color='#344054', lw=1, ls=':', label='2.15초 출발 금지 성립')
+    axis.axhline(0, color='#98a2b3', lw=.7)
+    axis.set_xlim(2., 3.)
+    axis.set_xlabel('시나리오 시작 후 시간 (초)')
+    axis.grid(axis='y', alpha=.2)
+    axis.legend(loc='best', frameon=False, fontsize=9)
+  figure.suptitle('OX 합성 신호 → 실제 Toyota CAN 계산의 재현·수정 비교\n' +
+                  '실물 송신 없음 · 확인 전 0.15초와 가정한 차량 응답 지연은 별도 제한', fontsize=13)
+  figure.savefig(args.output/'native_signal_can_before_after.png', dpi=160)
+  plt.close(figure)
+  summary = {'before': metrics(before), 'after': metrics(after), 'camera_recognition_verified': False,
+             'vehicle_verified': False, 'real_can_sent': False}
+  (args.output/'native_signal_can_before_after.json').write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding='utf-8')
+  print(json.dumps(summary, ensure_ascii=False))
+
+
+if __name__ == '__main__':
+  main()
