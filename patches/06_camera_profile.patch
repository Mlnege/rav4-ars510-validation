+"""알려진 OX03C10 프로파일의 실제 변환·원형 geometry·거절 계약 검증."""
+
+import ast
+import json
+from pathlib import Path
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT))
+from tools.ars510_offline.bootstrap import prepare  # noqa: TID251
+
+prepare()
+
+from openpilot.common.transformations.camera import DEVICE_CAMERAS
+from openpilot.selfdrive.carrot import signal_stop_prepare as geometry
+from openpilot.selfdrive.carrot.signal_stop_prepare_runtime import observation_intrinsics, publish_prepare_observation
+from openpilot.selfdrive.carrot.signal_stop_prepare_runtime import SignalPrepareRuntime
+from openpilot.selfdrive.carrot import signal_mode
+from openpilot.selfdrive.modeld.signal_tracking_shadow import copy_nv12_rgb, tracking_camera_profile
+from tools.ars510_validation.signal.core import SchemaInputs, observation_record  # noqa: TID251
+
+
+def packet():
+  return {'source_size': [1928, 1208], 'coordinate_transform': 'full_frame_resize'}
+
+
+def test_ox_matrix_is_official_full_frame_transform_and_preserves_optical_rays():
+  config = DEVICE_CAMERAS['tizi', 'ox03c10']
+  values = observation_intrinsics(config, 'tizi', 'ox03c10', packet())
+  expected = np.diag([1344/1928, 760/1208, 1.]) @ config.fcam.intrinsics
+  assert values == pytest.approx((expected[0, 0], expected[1, 1], expected[0, 2], expected[1, 2]))
+  assert values[0] != values[1]
+  for point in ((964., 604.), (668., 400.), (1300., 270.)):
+    native = np.linalg.inv(config.fcam.intrinsics) @ [*point, 1.]
+    reference = np.linalg.inv(expected) @ [point[0]*1344/1928, point[1]*760/1208, 1.]
+    assert reference == pytest.approx(native, abs=1e-12)
+
+
+@pytest.mark.parametrize('change', [None, {'source_size': [1344, 760]}, {'source_size': [1928, 1208], 'coordinate_transform': 'crop'},
+                                    {'source_size': [1928, 1208]}, {'coordinate_transform': 'full_frame_resize'}])
+def test_missing_or_wrong_ox_coordinate_provenance_is_rejected(change):
+  assert observation_intrinsics(DEVICE_CAMERAS['tizi', 'ox03c10'], 'tizi', 'ox03c10', change) is None
+
+
+@pytest.mark.parametrize('pair', [('tici', 'ox03c10'), ('tizi', 'ar0231'), ('tici', 'ar0231'), ('pc', 'unknown')])
+def test_other_nonreference_profiles_are_still_rejected(pair):
+  assert observation_intrinsics(DEVICE_CAMERAS[pair], *pair, packet()) is None
+
+
+def test_legacy_os_profile_needs_no_new_metadata_and_matches_original_geometry():
+  sm = SchemaInputs()
+  config = DEVICE_CAMERAS['tici', 'os04c10']
+  values = observation_intrinsics(config, 'tici', 'os04c10', {})
+  assert values == (1141.5, 1141.5, 672., 380.)
+  original_source = subprocess.run(['git', 'show', 'HEAD:openpilot/selfdrive/carrot/signal_stop_prepare.py'],
+                                   cwd=ROOT, capture_output=True, text=True, encoding='utf-8', check=True).stdout
+  tree = ast.parse(original_source)
+  nodes = [node for node in tree.body if isinstance(node, ast.FunctionDef)
+           and node.name in ('housing_range', 'housing_alignment')]
+  namespace = dict(vars(geometry))
+  exec(compile(ast.Module(body=nodes, type_ignores=[]), 'original_signal_geometry', 'exec'), namespace)
+  model = sm['modelV2']
+  args = (1141.5, [0., 0., 0.], model.roadEdges, model.roadEdgeStds,
+          model.laneLines, model.laneLineProbs, model.laneLineStds)
+  for box in ([667, 260, 707, 270], [700, 270, 740, 280], [640, 200, 680, 210], [500, 330, 540, 340]):
+    before = namespace['housing_range'](box, *args)
+    after = geometry.housing_range(box, *args, intrinsics=values)
+    assert after == before
+    if before is not None:
+      assert geometry.housing_alignment(box, before, *args, intrinsics=values) == namespace['housing_alignment'](box, before, *args)
+
+
+@pytest.mark.parametrize('intrinsics', [(0, 100, 672, 380), (100, 0, 672, 380), (np.nan, 100, 672, 380), (1, 2)])
+def test_invalid_projection_is_rejected(intrinsics):
+  sm = SchemaInputs()
+  model = sm['modelV2']
+  assert geometry.housing_range([667, 260, 707, 270], 1141.5, [0., 0., 0.], model.roadEdges,
+                                model.roadEdgeStds, intrinsics=intrinsics) is None
+
+
+def test_sender_selects_only_fresh_tizi_ox_profile():
+  sm = SchemaInputs(100.)
+  sm['deviceState'].deviceType = 'tizi'
+  sm['roadCameraState'].sensor = 'ox03c10'
+  frame = SimpleNamespace(width=1928, height=1208)
+  profile = tracking_camera_profile(frame, sm, 100.)
+  assert profile['source_size'] == [1928, 1208] and profile['coordinate_transform'] == 'full_frame_resize'
+  sm.recv_time['roadCameraState'] = 99.
+  assert tracking_camera_profile(frame, sm, 100.) is None
+  sm.touch(100.)
+  sm['deviceState'].deviceType = 'tici'
+  assert tracking_camera_profile(frame, sm, 100.) is None
+  assert tracking_camera_profile(SimpleNamespace(width=1344, height=760)) == {
+    'source_size': [1344, 760], 'coordinate_transform': 'identity'}
+
