+def test_actual_nv12_conversion_and_resize_keep_uniform_pixels():
+  pytest.importorskip('cv2')
+  width, height, stride = 1928, 1208, 1928
+  raw = np.full(stride * height * 3 // 2, 128, dtype=np.uint8)
+  frame = SimpleNamespace(width=width, height=height, stride=stride, uv_offset=stride*height, data=raw)
+  metadata = SchemaInputs(100.)
+  metadata['deviceState'].deviceType = 'tizi'
+  metadata['roadCameraState'].sensor = 'ox03c10'
+  profile = tracking_camera_profile(frame, metadata, 100.)
+  actual = copy_nv12_rgb(frame, profile=profile)
+  assert actual.shape == (760, 1344, 3)
+  # NV12의 Y=128, U=V=128은 BT.601 한정 범위에서 반올림한 중성 회색130이다.
+  assert np.all(actual == 130)
+  with pytest.raises(ValueError):
+    copy_nv12_rgb(frame)
+  frame.data = raw[:-1]
+  with pytest.raises(ValueError):
+    copy_nv12_rgb(frame, profile=profile)
+
