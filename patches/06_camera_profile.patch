+def runtime_with_packet(tmp_path, monkeypatch, *, device='tizi', sensor='ox03c10', provenance=True, fault=None):
+  # 설정 읽기만 메모리로 격리한다. runtime·pose·보정·행렬 판단은 원형을 실행한다.
+  monkeypatch.setattr(signal_mode, '_params', SimpleNamespace(get_int=lambda key: 2))
+  monkeypatch.setattr(signal_mode, '_next_read', 0.)
+  runtime = SignalPrepareRuntime()
+  runtime.observation_path = tmp_path/'prepare.json'
+  sm = SchemaInputs(100.)
+  sm['deviceState'].deviceType = device
+  sm['roadCameraState'].sensor = sensor
+  runtime.extra = sm
+  runtime.read(sm, 100.)
+  now = 100.1
+  sm.touch(now)
+  record = observation_record(now, 1)
+  if provenance:
+    record.update(packet())
+  obj = {'version': 1, 'stream': 'road', 'size': [1344, 760], 'session': 'profile', 'frame_id': 1,
+         'timestamp': now, 'tracks': record['tracks']}
+  if provenance:
+    obj.update(packet())
+  if fault == 'crop':
+    obj['coordinate_transform'] = 'crop'
+  if fault == 'wrong_size':
+    obj['source_size'] = [1344, 760]
+  if fault == 'uncalibrated':
+    sm['liveCalibration'].calStatus = 'uncalibrated'
+  if fault == 'pose_invalid':
+    sm['livePose'].sensorsOK = False
+  if fault == 'pose_stale':
+    sm['livePose'].timestamp = int((now-.3)*1e9)
+  if fault == 'camera_stale':
+    sm.recv_time['roadCameraState'] = now-.3
+  if fault == 'camera_invalid':
+    sm.valid['roadCameraState'] = False
+  if fault == 'nan_std':
+    sm['livePose'].angularVelocityDevice.xStd = np.nan
+  runtime.observation_path.write_text(json.dumps(obj), encoding='utf-8')
+  return runtime.read(sm, now), sm
+
+
+def test_actual_runtime_accepts_tizi_ox_and_uses_scaled_geometry(tmp_path, monkeypatch):
+  (observation, context), sm = runtime_with_packet(tmp_path, monkeypatch)
+  assert observation is not None and context['valid'] and context['enabled'] and context['actuate']
+  assert not context['turning']
+  bounds = context['geometry']([667, 260, 707, 270])
+  assert bounds is not None and 25 <= bounds[0] < bounds[1] <= 140
+  assert context['alignment']([667, 260, 707, 270], bounds) is not None
+  assert sm['roadCameraState'].sensor == 'ox03c10'
+
+
+@pytest.mark.parametrize('fault', ['crop', 'wrong_size', 'uncalibrated', 'pose_invalid', 'pose_stale',
+                                 'camera_stale', 'camera_invalid', 'nan_std'])
+def test_actual_runtime_keeps_existing_validity_and_provenance_fail_closed(tmp_path, monkeypatch, fault):
+  (_, context), _ = runtime_with_packet(tmp_path, monkeypatch, fault=fault)
+  assert not context['valid']
+
+
+def test_actual_runtime_rejects_unmarked_ox_but_preserves_unmarked_os(tmp_path, monkeypatch):
+  (_, ox), _ = runtime_with_packet(tmp_path, monkeypatch, provenance=False)
+  assert not ox['valid']
+  (_, legacy), _ = runtime_with_packet(tmp_path, monkeypatch, device='tici', sensor='os04c10', provenance=False)
+  assert legacy['valid']
