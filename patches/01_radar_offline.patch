@@ -0,0 +1,75 @@
+"""저장 로그의 허용된 설정·실제 제어 활성 상태·내비 제한 통계만 확인한다."""
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+import re
+
+from .bootstrap import prepare
+
+prepare()
+import capnp
+from .replay import events
+
+
+ALLOWED_SETTINGS = {"SpeedFromPCM", "TurnSpeedControlMode", "AutoCurveSpeedFactor", "MapTurnSpeedFactor", "AutoTurnControl"}
+ALLOWED_SOURCES = {"vturn", "route", "road", "cam", "atc", "atc2", "section", "bump", "police", "waze", "hda",
+                   "hda_bump", "school", "hda_section"}
+
+
+def inspect(path, schema):
+  settings = {}
+  controls, sources = Counter(), Counter()
+  speeds = set()
+  desired = []
+  cp = []
+  with events(path, schema) as stream:
+    for event in stream:
+      kind = event.which()
+      if kind == "initData":
+        for item in event.initData.params.entries:
+          if item.key in ALLOWED_SETTINGS:
+            value = bytes(item.value).decode("ascii", errors="ignore")
+            if re.fullmatch(r"[+-]?\d{1,4}(?:\.\d{1,6})?", value):
+              settings[item.key] = float(value)
+      elif kind == "carParams":
+        cp.append({"radarUnavailable": event.carParams.radarUnavailable,
+                   "openpilotLongitudinalControl": event.carParams.openpilotLongitudinalControl})
+      elif kind == "carState":
+        speeds.add(round(event.carState.cruiseState.speed * 3.6, 3))
+      elif kind == "carControl":
+        controls["messages"] += 1
+        controls["enabled"] += int(event.carControl.enabled)
+        controls["longActive"] += int(event.carControl.longActive)
+      elif kind == "carrotMan":
+        nav = event.carrotMan
+        value = float(nav.desiredSpeed)
+        if 0 < value <= 250:
+          desired.append(value)
+        source = str(nav.desiredSource)
+        sources[source if source in ALLOWED_SOURCES else "other"] += 1
+  return {"file": path.name, "settings_at_init": settings, "carParams": cp,
+          "carControl_counts": dict(controls), "pcm_set_speed_distinct_count": len(speeds),
+          "carrotMan_source_counts": dict(sources), "desired_speed_range_kph": [min(desired, default=None), max(desired, default=None)]}
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("logs", type=Path)
+  parser.add_argument("--schemas", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  args = parser.parse_args()
+  root = args.schemas.resolve()
+  schema = capnp.SchemaParser().load((root / "log.capnp").as_posix(), imports=[root.as_posix(), (root / "include").as_posix()])
+  paths = [args.logs] if args.logs.is_file() else sorted(args.logs.glob("rlog*.zst"))
+  if not paths:
+    raise RuntimeError("로컬 rlog*.zst 파일이 없습니다")
+  results = [inspect(path, schema.Event) for path in paths]
+  args.output.mkdir(parents=True, exist_ok=True)
+  (args.output / "control_context.json").write_text(json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8")
+  for result in results:
+    print(json.dumps(result, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+  main()
