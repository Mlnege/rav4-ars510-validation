+"""데스크톱 분석 프로세스의 경로와 금지된 설정 접근을 구성한다."""
+from pathlib import Path
+import sys
+from types import ModuleType
+
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
+
+def prepare():
+  for path in (REPO_ROOT, REPO_ROOT / "opendbc_repo"):
+    if str(path) not in sys.path:
+      sys.path.insert(0, str(path))
+  try:
+    import openpilot.common.params  # noqa: F401
+    return "native-imported-unused"
+  except ModuleNotFoundError as exc:
+    if exc.name != "openpilot.common.params_pyx":
+      raise
+
+  class ForbiddenParams:
+    def __init__(self, *args, **kwargs):
+      raise RuntimeError("오프라인 재생에서 Params 접근은 허용하지 않습니다")
+
+  # 설정 저장소만 차단한다. CAN 파서, 필터, 스키마, 레이더 알고리즘은 원본을 사용한다.
+  module = ModuleType("openpilot.common.params")
+  module.Params = ForbiddenParams
+  sys.modules[module.__name__] = module
+  return "process-local-access-forbidden"
