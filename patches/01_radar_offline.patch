@@ -0,0 +1,188 @@
+"""로컬 rlog를 ARS510→Carrot 필터→liveTracks→실제 lead 선택 코어로 재생한다.
+
+실차 인터페이스 등록, Params 변경, 소켓 연결, CAN 송신, planner 실행은 없다.
+저장된 modelV2만 사용하며 합성 객체나 합성 비전 lead를 만들지 않는다.
+"""
+from __future__ import annotations
+
+import argparse
+from contextlib import contextmanager
+import csv
+import json
+import math
+from pathlib import Path
+import shutil
+import tempfile
+
+from .bootstrap import prepare
+
+PARAMS_BACKEND = prepare()
+
+import capnp
+import zstandard
+from openpilot.cereal import car, log
+from openpilot.selfdrive.carrot.radar_motion import DPathRadarController
+from openpilot.selfdrive.carrot.radar_motion.coordinates import device_yaw_to_radar
+from openpilot.selfdrive.carrot.radar_motion.native import BACKEND as MOTION_BACKEND
+from openpilot.selfdrive.carrot.radar_motion.timing import front_radar_distance_delay_s
+from opendbc.car.toyota.ars510_offline import Ars510OfflineRadarInterface
+
+
+@contextmanager
+def events(path, event_schema):
+  with tempfile.TemporaryFile("w+b") as decoded:
+    with path.open("rb") as source, zstandard.ZstdDecompressor().stream_reader(source) as stream:
+      shutil.copyfileobj(stream, decoded)
+    decoded.seek(0)
+    yield event_schema.read_multiple(decoded, traversal_limit_in_words=64 * 1024 * 1024)
+
+
+def _lead_count(output):
+  return sum(bool(lead and lead.get("status") and lead.get("radar")) for lead in (output.lead_one, output.lead_two))
+
+
+def replay(path, event_schema, output_dir):
+  cp_bytes = None
+  software = []
+  with events(path, event_schema) as stream:
+    for event in stream:
+      kind = event.which()
+      if kind == "carParams" and cp_bytes is None:
+        cp_bytes = event.carParams.as_builder().to_bytes()
+      elif kind == "initData":
+        software.append({key: getattr(event.initData, key) for key in ("version", "gitCommit", "gitBranch")})
+  if cp_bytes is None:
+    return {"file": path.name, "status": "insufficient_carParams", "software": software,
+            "records": 0, "points": 0, "pipeline_model_updates": 0}
+  with car.CarParams.from_bytes(cp_bytes) as reader:
+    CP = reader.as_builder()
+  before = CP.to_dict()
+  radar = Ars510OfflineRadarInterface(CP, offline=True)
+  # 로그의 radarUnavailable은 유지한다. 수신 코드 검증용 독립 인스턴스에서만 레이더 모드1을 사용한다.
+  controller = DPathRadarController(enable_radar_tracks=1, production_live_tracks=True,
+                                   front_radar_measurement_delay_s=front_radar_distance_delay_s(CP))
+  baseline = DPathRadarController(enable_radar_tracks=-2, production_live_tracks=True,
+                                 front_radar_measurement_delay_s=front_radar_distance_delay_s(CP))
+  counts = dict.fromkeys(("points", "serialized_liveTracks", "pipeline_model_updates", "models_with_points",
+                         "points_present_at_models", "radar_lead_selections", "baseline_radar_lead_selections",
+                         "serialized_radarState", "radar_state_error_models", "nonfinite_required", "error_publications"), 0)
+  track_ids = set()
+  extrema = {key: [math.inf, -math.inf] for key in ("dRel", "yRel", "vRel", "vLead", "aLead", "jLead")}
+  v_ego = a_ego = yaw = 0.0
+  have_state = False
+  rr = car.RadarData.new_message()
+  radar_state_error_counts = dict.fromkeys(rr.errors.to_dict(), 0)
+  rr.errors.radarUnavailableTemporary = True
+  tracks_time = None
+  first_ns = None
+  previous_points = set()
+  deletions = 0
+  output_dir.mkdir(parents=True, exist_ok=True)
+  with (output_dir / f"{path.stem}.pipeline_points.csv").open("w", newline="", encoding="utf-8") as points_file:
+    fields = ["t_s", "trackId", "dRel", "yRel", "vRel", "vLead", "aLead", "jLead", "measured"]
+    writer = csv.DictWriter(points_file, fieldnames=fields)
+    writer.writeheader()
+    with events(path, event_schema) as stream:
+      for event in stream:
+        kind = event.which()
+        nanos = int(event.logMonoTime)
+        if first_ns is None:
+          first_ns = nanos
+        t = nanos * 1e-9
+        if kind == "carState":
+          v_ego, a_ego = float(event.carState.vEgo), float(event.carState.aEgo)
+          have_state = True
+        elif kind == "livePose":
+          pose = event.livePose
+          angular = pose.angularVelocityDevice
+          yaw = device_yaw_to_radar(float(angular.z)) if angular.valid and pose.inputsOK and pose.sensorsOK else 0.0
+        elif kind == "can":
+          packets = [(nanos, [(int(f.address), bytes(f.dat), int(f.src)) for f in event.can])]
+          result = radar.update_carrot(v_ego, a_ego, t, packets)
+          if result is None:
+            continue
+          event_out = log.Event.new_message(logMonoTime=nanos)
+          event_out.liveTracks = result
+          # 실제 최신 cereal 스키마로 직렬화하고 다시 읽어 기존 파이프라인 입력을 만든다.
+          with log.Event.from_bytes(event_out.to_bytes()) as decoded:
+            rr = decoded.liveTracks.as_builder()
+          tracks_time = t
+          counts["serialized_liveTracks"] += 1
+          counts["error_publications"] += int(any(rr.errors.to_dict().values()))
+          current_points = {int(p.trackId) for p in rr.points}
+          deletions += len(previous_points - current_points)
+          previous_points = current_points
+          for point in rr.points:
+            values = {key: getattr(point, key) for key in fields if key != "t_s"}
+            values["t_s"] = (nanos - first_ns) * 1e-9
+            writer.writerow(values)
+            counts["points"] += 1
+            track_ids.add(int(point.trackId))
+            required = [float(getattr(point, key)) for key in extrema]
+            counts["nonfinite_required"] += int(not all(math.isfinite(value) for value in required))
+            for key, value in zip(extrema, required, strict=True):
+              extrema[key][0] = min(extrema[key][0], value)
+              extrema[key][1] = max(extrema[key][1], value)
+        elif kind == "modelV2" and have_state and tracks_time is not None:
+          model = event.modelV2
+          model_t = int(model.timestampEof) * 1e-9 if model.timestampEof else t
+          output = controller.update(time_s=model_t, v_ego=v_ego, radar_points=rr.points, model=model,
+                                     yaw_rate_rad_s=yaw, radar_to_model_time_s=model_t - tracks_time)
+          vision_output = baseline.update(time_s=model_t, v_ego=v_ego, radar_points=rr.points, model=model,
+                                          yaw_rate_rad_s=yaw, radar_to_model_time_s=model_t - tracks_time)
+          counts["pipeline_model_updates"] += 1
+          counts["models_with_points"] += int(bool(rr.points))
+          counts["points_present_at_models"] += len(rr.points)
+          counts["radar_lead_selections"] += _lead_count(output)
+          counts["baseline_radar_lead_selections"] += _lead_count(vision_output)
+          radar_state = log.RadarState.new_message()
+          # 실제 RadarD와 같은 오류를 전달해 수신 실패를 정상 상태로 바꾸지 않는다.
+          radar_state.radarErrors = rr.errors
+          if output.lead_one:
+            radar_state.leadOne = output.lead_one
+          if output.lead_two:
+            radar_state.leadTwo = output.lead_two
+          with log.RadarState.from_bytes(radar_state.to_bytes()) as state:
+            assert bool(state.leadOne.radar) == bool(output.lead_one and output.lead_one.get("radar"))
+            assert state.radarErrors.to_dict() == rr.errors.to_dict()
+            counts["radar_state_error_models"] += int(any(state.radarErrors.to_dict().values()))
+            for name, value in state.radarErrors.to_dict().items():
+              radar_state_error_counts[name] += int(value)
+          counts["serialized_radarState"] += 1
+  after = CP.to_dict()
+  if before != after:
+    raise RuntimeError("CarParams가 오프라인 재생 중 변경되었습니다")
+  if counts["nonfinite_required"]:
+    raise RuntimeError("필수 객체 필드에 비유한 값이 있습니다")
+  return {"file": path.name, "status": "offline_replayed", "software": software,
+          "original_radarUnavailable": bool(CP.radarUnavailable),
+          "original_openpilotLongitudinalControl": bool(CP.openpilotLongitudinalControl),
+          "carParams_unchanged": True, "params_backend": PARAMS_BACKEND, "motion_backend": MOTION_BACKEND,
+          **counts, "unique_tracks": len(track_ids), "deleted_track_occurrences": deletions,
+          "radar_state_error_counts": radar_state_error_counts,
+          "ranges": {key: value if counts["points"] else [None, None] for key, value in extrema.items()},
+          "diagnostics": radar.diagnostics}
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("logs", type=Path, help="로컬 rlog.zst 또는 rlog*.zst 디렉터리")
+  parser.add_argument("--schemas", type=Path, required=True, help="기록 당시 전체 Cap'n Proto 스키마 디렉터리")
+  parser.add_argument("--output", type=Path, required=True, help="익명 통계와 상대시각 객체 CSV 출력 디렉터리")
+  args = parser.parse_args()
+  schema_parser = capnp.SchemaParser()
+  schemas = args.schemas.resolve()
+  schema = schema_parser.load((schemas / "log.capnp").as_posix(), imports=[schemas.as_posix(), (schemas / "include").as_posix()])
+  paths = [args.logs] if args.logs.is_file() else sorted(args.logs.glob("rlog*.zst"))
+  if not paths:
+    raise RuntimeError("로컬 rlog*.zst 파일이 없습니다")
+  results = []
+  for path in paths:
+    result = replay(path, schema.Event, args.output)
+    results.append(result)
+    print(json.dumps(result, ensure_ascii=False, allow_nan=False), flush=True)
+  (args.output / "pipeline_results.json").write_text(json.dumps(results, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
+
+
+if __name__ == "__main__":
+  main()
