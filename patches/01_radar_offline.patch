+@pytest.mark.parametrize("fault, reason", [("drop", "sequence_errors"), ("reorder", "sequence_errors"),
+                                          ("duplicate", "sequence_errors"), ("short", "bad_frame_length"),
+                                          ("type", "bad_frame_type"), ("reverse", "reversed_time"),
+                                          ("nan", "nonfinite_time"), ("slow", "assembly_timeout")])
+def test_strict_transport_rejects_incomplete_or_invalid_records_and_recovers(fault, reason):
+  frames = segment(make_record())
+  if fault == "drop":
+    del frames[5]
+  elif fault == "reorder":
+    frames[5], frames[6] = frames[6], frames[5]
+    frames[5] = (1.0005, frames[5][1])
+    frames[6] = (1.0006, frames[6][1])
+  elif fault == "duplicate":
+    frames.insert(6, frames[5])
+  elif fault == "short":
+    frames[5] = (frames[5][0], frames[5][1][:-1])
+  elif fault == "type":
+    frames[5] = (frames[5][0], bytes([0x35]) + frames[5][1][1:])
+  elif fault == "reverse":
+    frames[5] = (0.99, frames[5][1])
+  elif fault == "nan":
+    frames[5] = (math.nan, frames[5][1])
+  elif fault == "slow":
+    frames = [(time_s + (0.2 if index >= 5 else 0), data) for index, (time_s, data) in enumerate(frames)]
+  assembler = StrictId80RecordAssembler()
+  assert all(assembler.push(time_s, data) is None for time_s, data in frames)
+  assert assembler.counters[reason] > 0
+  recovered = [assembler.push(time_s, data) for time_s, data in segment(make_record(), 2.0)]
+  assert recovered[-1] is not None
+  assert recovered[-1].payload == make_record()
+
