diff --git a/tools/ars510_offline/diagnose.py b/tools/ars510_offline/diagnose.py
new file mode 100644
index 0000000..a854904
--- /dev/null
+++ b/tools/ars510_offline/diagnose.py
@@ -0,0 +1,154 @@
+"""로컬 CAN의 길이·CRC·슬롯 구조를 확인하고 공개 DBC와 독립적으로 대조한다."""
+from __future__ import annotations
+
+import argparse
+from collections import Counter
+import csv
+import json
+from pathlib import Path
+
+from .bootstrap import prepare
+
+prepare()
+import capnp
+import cantools
+from .replay import events
+from opendbc.car.toyota.ars510.objects import decode_native_slot, slot_bits
+from opendbc.car.toyota.ars510.record import id80_crc_ok, live_object_count, occupied_slots
+from opendbc.car.toyota.ars510.shell85 import id85_crc_ok
+from opendbc.car.toyota.ars510.transport import Id85RecordAssembler
+from opendbc.car.toyota.ars510_offline import StrictId80RecordAssembler
+
+
+DBC_ROOT = Path(__file__).resolve().parent / "dbc"
+
+
+def diagnose(path, event_schema, objects_dbc, acc_dbc):
+  assemblers = {bus: StrictId80RecordAssembler() for bus in range(3)}
+  metadata = {bus: Id85RecordAssembler() for bus in range(3)}
+  counts, crc80, crc85, rec80, rec85 = Counter(), Counter(), Counter(), Counter(), Counter()
+  acc_frames, acc_errors, states, presence = Counter(), Counter(), Counter(), Counter()
+  slot_mismatch = header_mismatch = dbc_mismatch = native_slots = 0
+  dbc_slots = geometry_valid = 0
+  sizes, assembly_times, periods = Counter(), [], []
+  first_time = last_time = None
+  previous_record = None
+  acc_ranges = {name: [None, None] for name in ("REL_SPEED", "LONG_DIST", "LAT_DIST")}
+  cp_values = []
+  with events(path, event_schema) as stream:
+    for event in stream:
+      t = event.logMonoTime * 1e-9
+      if first_time is None:
+        first_time = t
+      last_time = t
+      if event.which() == "carParams":
+        cp = event.carParams
+        cp_values.append({key: getattr(cp, key) for key in
+                          ("carFingerprint", "radarUnavailable", "openpilotLongitudinalControl", "flags")}
+                         | {"carFw_entries": len(cp.carFw)})
+      if event.which() != "can":
+        continue
+      for frame in event.can:
+        bus, address, data = int(frame.src), int(frame.address), bytes(frame.dat)
+        if address in (0x80, 0x81, 0x85, 0x86, 0x235, 0x237, 0x239, 0x23b, 0xb4, 0x24, 0x192, 0x194):
+          counts[f"{bus}:0x{address:03x}"] += 1
+          sizes[f"{bus}:0x{address:03x}:DLC{len(data)}"] += 1
+        if bus == 1 and address in (0x235, 0x237, 0x239, 0x23b):
+          try:
+            decoded = acc_dbc.decode_message(address, data, decode_choices=False)
+            acc_frames[f"0x{address:03x}"] += 1
+            if "STATE" in decoded:
+              states[f"0x{address:03x}:{int(decoded['STATE'])}"] += 1
+            if "PRESENT" in decoded:
+              presence[f"0x{address:03x}:{int(decoded['PRESENT'])}"] += 1
+            for key in acc_ranges.keys() & decoded.keys():
+              value = decoded[key]
+              low, high = acc_ranges[key]
+              acc_ranges[key] = [value if low is None else min(low, value), value if high is None else max(high, value)]
+          except (ValueError, cantools.database.errors.DecodeError):
+            acc_errors[f"0x{address:03x}"] += 1
+        if bus not in assemblers:
+          continue
+        if address == 0x85:
+          record = metadata[bus].push(t, data)
+          if record is not None:
+            rec85[bus] += 1
+            crc85[bus] += int(id85_crc_ok(record.payload))
+        if address != 0x80:
+          continue
+        record = assemblers[bus].push(t, data)
+        if record is None:
+          continue
+        rec80[bus] += 1
+        if not id80_crc_ok(record.payload):
+          continue
+        crc80[bus] += 1
+        if bus != 1:
+          continue
+        assembly_times.append(t - record.time_s)
+        if previous_record is not None:
+          periods.append(record.time_s - previous_record)
+        previous_record = record.time_s
+        allocated = 0
+        for slot in range(20):
+          data_slot = record.payload[17 + slot * 36:53 + slot * 36]
+          index = slot_bits(data_slot, 2, 6)
+          slot_mismatch += int(index not in (slot, 63))
+          allocated += int(index == slot)
+        header_mismatch += int(allocated != live_object_count(record.payload))
+        for slot, data_slot in occupied_slots(record.payload):
+          obj = decode_native_slot(slot, data_slot)
+          native_slots += 1
+          geometry_valid += int(obj.geometry_valid and obj.lateral_valid)
+          decoded = objects_dbc.decode_message(0x700 + slot, data_slot + bytes(12), decode_choices=False)
+          dbc_slots += 1
+          # 가상 DBC에는 재조립한 슬롯만 넣는다. 0x700은 실 CAN 수신 주소가 아니다.
+          expected = {"DREL": obj.d_rel, "YREL_LEFT": obj.y_rel, "VLONG_OVER_GROUND": obj.v_long_ground}
+          dbc_mismatch += int(any(abs(decoded[key] - value) > 1e-9 for key, value in expected.items()))
+  return {"file": path.name, "duration_s": None if first_time is None else last_time - first_time,
+          "carParams": cp_values, "can_counts": dict(counts), "frame_lengths": dict(sizes),
+          "id80_records": dict(rec80), "id80_crc_valid": dict(crc80), "id85_records": dict(rec85),
+          "id85_crc_valid": dict(crc85), "id80_transport": {bus: dict(a.counters) for bus, a in assemblers.items()},
+          "slot_index_mismatch": slot_mismatch, "header_allocation_mismatch": header_mismatch,
+          "occupied_slot_samples": native_slots, "geometry_valid_slot_samples": geometry_valid,
+          "dbc_slot_samples": dbc_slots, "dbc_slot_mismatch": dbc_mismatch,
+          "assembly_duration_s": [min(assembly_times, default=None), max(assembly_times, default=None)],
+          "record_period_s": [min(periods, default=None), max(periods, default=None)],
+          "acc_dbc_frames": dict(acc_frames), "acc_dbc_errors": dict(acc_errors),
+          "acc_states": dict(states), "acc_presence": dict(presence), "acc_dbc_ranges_including_idle": acc_ranges}
+
+
+def main():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("logs", type=Path)
+  parser.add_argument("--schemas", type=Path, required=True)
+  parser.add_argument("--output", type=Path, required=True)
+  args = parser.parse_args()
+  parser_schema = capnp.SchemaParser()
+  schemas = args.schemas.resolve()
+  schema = parser_schema.load((schemas / "log.capnp").as_posix(), imports=[schemas.as_posix(), (schemas / "include").as_posix()])
+  objects_dbc = cantools.database.load_file(DBC_ROOT / "ars510_objects_vbus.dbc", strict=False)
+  acc_dbc = cantools.database.load_file(DBC_ROOT / "toyota_tss2_ars510.dbc", strict=False)
+  paths = [args.logs] if args.logs.is_file() else sorted(args.logs.glob("rlog*.zst"))
+  if not paths:
+    raise RuntimeError("로컬 rlog*.zst 파일이 없습니다")
+  results = [diagnose(path, schema.Event, objects_dbc, acc_dbc) for path in paths]
+  args.output.mkdir(parents=True, exist_ok=True)
+  (args.output / "diagnostics.json").write_text(json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8")
+  with (args.output / "dbc_signals.csv").open("w", newline="", encoding="utf-8-sig") as output:
+    writer = csv.writer(output)
+    writer.writerow(["DBC", "CAN_ID", "메시지", "신호", "시작비트", "길이", "순서", "부호", "배율", "오프셋", "단위"])
+    for name in ("ars510_radar_bus.dbc", "ars510_objects_vbus.dbc", "toyota_tss2_ars510.dbc"):
+      dbc = cantools.database.load_file(DBC_ROOT / name, strict=False)
+      for message in dbc.messages:
+        for signal in message.signals:
+          writer.writerow([name, hex(message.frame_id), message.name, signal.name, signal.start, signal.length,
+                           signal.byte_order, signal.is_signed, signal.scale, signal.offset, signal.unit or ""])
+  for result in results:
+    print(json.dumps({key: result[key] for key in ("file", "id80_crc_valid", "id85_crc_valid", "geometry_valid_slot_samples",
+                                                 "slot_index_mismatch", "header_allocation_mismatch", "dbc_slot_samples",
+                                                 "dbc_slot_mismatch", "acc_dbc_frames", "acc_dbc_errors")}, ensure_ascii=False))
+
+
+if __name__ == "__main__":
+  main()
