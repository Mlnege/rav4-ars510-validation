@@ -0,0 +1,427 @@
+"""저장 CAN 전용 ARS510 어댑터의 거절·수명·실제 Carrot 필터 검증."""
+
+import csv
+from collections import deque
+import math
+from pathlib import Path
+import sys
+import zlib
+
+import pytest
+
+
+OPENDBC_ROOT = Path(__file__).resolve().parents[4]
+OPENPILOT_ROOT = OPENDBC_ROOT.parent
+sys.path.insert(0, str(OPENPILOT_ROOT))
+sys.path.insert(0, str(OPENDBC_ROOT))
+
+from tools.ars510_offline.bootstrap import prepare
+
+prepare()
+
+from opendbc.car import structs
+from opendbc.car.interfaces import RadarInterfaceBase
+from opendbc.car.radar_tracks import MyTrack
+from opendbc.car.toyota.ars510.constants import ID80_IDLE_SLOT
+from opendbc.car.toyota.ars510.record import id80_crc_ok
+from opendbc.car.toyota.ars510_offline import Ars510OfflineRadarInterface, StrictId80RecordAssembler
+from opendbc.car.toyota.radar_interface import RadarInterface as LegacyRadarInterface
+from opendbc.car.toyota.values import CAR, ToyotaFlags
+
+
+def make_cp(*, platform=CAR.TOYOTA_RAV4_TSS2_2022, flags=ToyotaFlags.RADAR_ACC):
+  cp = structs.CarParams()
+  cp.carFingerprint = str(platform)
+  cp.flags = int(flags)
+  cp.radarUnavailable = True
+  cp.openpilotLongitudinalControl = True
+  cp.radarTimeStep = 0.05
+  cp.radarDelay = 0.0
+  cp.safetyConfigs = [{"safetyModel": "toyota", "safetyParam": 0}]
+  return cp
+
+
+def snapshot_cp(cp):
+  serialized = cp.to_bytes()
+  cp.clear_write_flag()
+  return serialized
+
+
+def make_record(*, occupied=True, speed_code=610, age=126, slot=0, distance_code=640, predicted=False):
+  # 36바이트 슬롯의 공개 비트 배치에 알려진 코드값을 넣는다. 이 합성
+  # 객체는 프로토콜/필터 단위 검증에만 쓰이며 실차 관측 증거가 아니다.
+  record = bytearray(742)
+  record[0] = 0xe4
+  for index in range(20):
+    record[17 + index * 36:53 + index * 36] = ID80_IDLE_SLOT
+  if occupied:
+    fields = ((0, 1), (2, slot), (16, 100), (24, age), (32, distance_code), (44, 2048),
+              (56, 45), (64, speed_code), (74, 510), (84, 511), (163, 2),
+              (216, 19), (240, 4), (107, int(predicted)))
+    value = sum(code << bit for bit, code in fields)
+    record[17 + slot * 36:53 + slot * 36] = value.to_bytes(36, "little")
+    record[14] = 1 << 3
+  record[737:741] = zlib.crc32(record[1:737]).to_bytes(4, "little")
+  return bytes(record)
+
+
+def segment(record, start=1.0):
+  assert len(record) == 742
+  return [(start + index * 0.0001,
+           bytes([0x12 if index == 0 else 0x20 | (index & 15)]) + record[index * 7:index * 7 + 7])
+          for index in range(106)]
+
+
+def packets(record, start=1.0, *, ego=True, bus=1):
+  result = []
+  if ego:
+    speed = bytes(5) + (3600).to_bytes(2, "big") + bytes(1)
+    yaw = (512).to_bytes(2, "big") + bytes(6)
+    result.append((round(start * 1e9), [(0xb4, speed, 0), (0x24, yaw, 0)]))
+  result += [(round(time_s * 1e9), [(0x80, payload, bus)]) for time_s, payload in segment(record, start)]
+  return result
+
