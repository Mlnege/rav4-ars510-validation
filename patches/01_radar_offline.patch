@@ -0,0 +1,36 @@
+"""기존 TSS2/TSS-P Toyota의 실제 DBC 파서와 객체 발행을 검증한다."""
+from pathlib import Path
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from tools.ars510_offline.bootstrap import prepare  # noqa: TID251
+
+prepare()
+from opendbc.can import CANPacker
+from opendbc.car import Bus, structs
+from opendbc.car.toyota.radar_interface import RadarInterface
+from opendbc.car.toyota.values import CAR, DBC
+
+
+@pytest.mark.parametrize("platform", [CAR.TOYOTA_RAV4_TSS2, CAR.TOYOTA_RAV4])
+def test_original_toyota_dbc_tracks_reach_mytrack(platform):
+  CP = structs.CarParams(carFingerprint=str(platform), radarUnavailable=False, radarTimeStep=0.05, radarDelay=0.)
+  radar = RadarInterface(CP)
+  packer = CANPacker(DBC[platform][Bus.radar])
+  for index in range(10):
+    nanos = 1_000_000_000 + index * 50_000_000
+    frames = [packer.make_can_msg(address, 1, {"LONG_DIST": 30., "LAT_DIST": -0.4, "REL_SPEED": -2.,
+                                             "VALID": 1, "NEW_TRACK": 0}) for address in radar.RADAR_A_MSGS]
+    frames += [packer.make_can_msg(address, 1, {"SCORE": 100}) for address in radar.RADAR_B_MSGS]
+    result = radar.update_carrot(10., 0., nanos * 1e-9, [(nanos, frames)])
+  assert result is not None
+  assert len(result.points) == len(radar.pts) == len(radar.tracks) == 16
+  assert not any(result.errors.to_dict().values())
+  for point in result.points:
+    assert point.dRel == pytest.approx(30.)
+    assert point.yRel == pytest.approx(0.4)
+    assert point.vRel == pytest.approx(-2.)
+    assert point.vLead == pytest.approx(8.)
+    assert point.measured and str(point.radarSource) == "frontRadar"
