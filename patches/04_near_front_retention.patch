diff --git a/tools/ars510_validation/native/test_near_front_retention.py b/tools/ars510_validation/native/test_near_front_retention.py
new file mode 100644
index 0000000..df453e8
--- /dev/null
+++ b/tools/ars510_validation/native/test_near_front_retention.py
@@ -0,0 +1,181 @@
+"""실제 당근 controller의 근거리 유지와 신규 획득·시각·측정 거절을 검증한다."""
+from pathlib import Path
+import math
+import importlib.util
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[4] / "native_sim"))
+from offline_io import prepare
+
+prepare()
+from openpilot.cereal import car, log
+from openpilot.selfdrive.carrot.radar_motion import DPathRadarController
+
+
+def model(distance, speed=0.0, probability=.99):
+  result = log.ModelDataV2()
+  result.position.x, result.position.y = [0., 100.], [0., 0.]
+  result.velocity.x = [.2]
+  lead = result.init("leadsV3", 1)[0]
+  lead.x, lead.y, lead.v, lead.a = [distance + 1.52] * 4, [0.] * 4, [speed] * 4, [0.] * 4
+  lead.xStd, lead.yStd, lead.vStd = [1.] * 4, [.5] * 4, [1.] * 4
+  lead.prob = probability
+  return result
+
+
+def point(distance, **overrides):
+  values = {"trackId": 1001, "dRel": distance, "yRel": 0.0, "vRel": -.2, "vLead": 0.0,
+            "aLead": 0.0, "jLead": 0.0, "aRel": 0.0, "yvRel": 0.0, "measured": True, "radarSource": "frontRadar"}
+  values.update(overrides)
+  return car.RadarData.RadarPoint(**values)
+
+
+def controller(enabled=True):
+  return DPathRadarController(production_live_tracks=True, retain_confirmed_near_front=enabled)
+
+
+def step(control, time=10., distance=.6, *, points=None, ego=.2, skew=0., speed=0., probability=.99):
+  return control.update(time_s=time, v_ego=ego, radar_points=[point(distance)] if points is None else points,
+                        model=model(distance, speed, probability), radar_to_model_time_s=skew)
+
+
+def seeded(control):
+  for index in range(12):
+    output = step(control, time=10. + index * .05)
+  assert output.lead_one and output.lead_one["radar"]
+  assert control._near_front_point is not None
+  return 10.6
+
+
+def test_current_same_id_near_measurement_is_preserved():
+  control = controller()
+  now = seeded(control)
+  output = step(control, now, .49)
+  assert output.lead_one and output.lead_one["radarTrackId"] == 1001
+  assert output.lead_one["dRel"] == pytest.approx(.49)
+  assert output.lead_one["modelProb"] == 0.0
+  for index in range(1, 20):
+    output = step(control, now + index * .05, .49)
+    assert output.lead_one and output.lead_one["radarTrackId"] == 1001
+
+
+def test_new_near_track_is_never_acquired():
+  output = step(controller(), distance=.49)
+  assert output.lead_one is None
+
+
+def test_default_policy_is_unchanged():
+  control = controller(False)
+  for index in range(12):
+    step(control, time=10. + index * .05)
+  assert step(control, 10.6, .49).lead_one is None
+
+
+@pytest.mark.parametrize("overrides", [
+  {"trackId": 1002}, {"measured": False}, {"radarSource": "scc"}, {"radarSource": "corner235"},
+  {"dRel": 0.0}, {"dRel": -.1}, {"dRel": math.nan}, {"yRel": math.nan},
+  {"vRel": math.nan}, {"vLead": math.nan}, {"yvRel": math.nan}, {"aLead": math.nan}, {"jLead": math.nan},
+  {"yRel": .6}, {"vRel": .8, "vLead": 1.0}, {"vRel": -1.2, "vLead": -1.0},
+  {"vLead": 1.0},
+])
+def test_invalid_or_different_current_measurement_drops_retention(overrides):
+  control = controller()
+  now = seeded(control)
+  output = step(control, now, .49, points=[point(.49, **overrides)])
+  if overrides.get('radarSource') == 'corner235':
+    # 기존 코너 이력 판단은 유지하며 새 근거리 유지 정책의 채택만 거절한다.
+    assert output.lead_one is None or output.lead_one['dRel'] > .5
+  else:
+    assert output.lead_one is None
+  assert control._near_front_point is None
+
+
+@pytest.mark.parametrize("points", [[], [point(.49), point(.49)], [point(.49, aLead=math.nan), point(.49)]])
+def test_absent_or_duplicate_observation_drops_retention(points):
+  control = controller()
+  now = seeded(control)
+  assert step(control, now, .49, points=points).lead_one is None
+
+
+@pytest.mark.parametrize("time,skew,ego", [
+  (10.55, 0., .2), (10.5, 0., .2), (10.6, .151, .2), (10.6, -.151, .2),
+  (10.8, 0., .2), (10.6, 0., .51), (10.6, 0., -.1),
+])
+def test_bad_time_staleness_or_ego_motion_drops_retention(time, skew, ego):
+  control = controller()
+  seeded(control)
+  assert step(control, time, .49, ego=ego, skew=skew).lead_one is None
+  assert control._near_front_point is None
+
+
+def test_same_old_publication_cannot_extend_observation_freshness():
+  control = controller()
+  now = seeded(control)
+  assert step(control, now, .49).lead_one is not None
+  assert step(control, now+.05, .49, skew=.05).lead_one is not None
+  assert step(control, now+.16, .49, skew=.16).lead_one is None
+
+
+def test_impossible_distance_jump_is_rejected():
+  control = controller()
+  now = seeded(control)
+  assert step(control, now, .2).lead_one is None
+
+
+def test_normal_above_boundary_target_resumes_existing_matcher():
+  control = controller()
+  now = seeded(control)
+  assert step(control, now, .49).lead_one is not None
+  output = step(control, now+.05, .6)
+  assert output.lead_one and output.lead_one["dRel"] == pytest.approx(.6)
+  assert output.lead_one["modelProb"] > .6
+
+
+@pytest.mark.parametrize("brand,fingerprint,direct,unavailable,expected", [
+  ("toyota", "TOYOTA_RAV4_TSS2_2022", True, True, False),
+  ("toyota", "TOYOTA_RAV4_TSS2_2022", True, False, True),
+  ("toyota", "TOYOTA_RAV4_TSS2_2022", False, False, False),
+  ("toyota", "TOYOTA_RAV4_TSS2_2023", True, False, False),
+  ("toyota", "TOYOTA_CHR_TSS2", True, False, False),
+  ("hyundai", "TOYOTA_RAV4_TSS2_2022", True, False, False),
+])
+def test_runtime_enablement_is_scoped_and_does_not_change_cp(brand, fingerprint, direct, unavailable, expected):
+  from openpilot.selfdrive.carrot.radar.radard_dpath import DPathRadarD
+  cp = car.CarParams(brand=brand, carFingerprint=fingerprint, openpilotLongitudinalControl=direct,
+                     radarUnavailable=unavailable)
+  before = cp.to_dict()
+  assert DPathRadarD(cp).controller.retain_confirmed_near_front is expected
+  assert cp.to_dict() == before
+
+
+def test_actual_rav4_interface_params_keep_policy_dormant():
+  from opendbc.car import gen_empty_fingerprint
+  from opendbc.car.toyota.interface import CarInterface
+  from opendbc.car.toyota.values import CAR
+  from openpilot.selfdrive.carrot.radar.radard_dpath import DPathRadarD
+  cp = CarInterface.get_params(CAR.TOYOTA_RAV4_TSS2_2022, gen_empty_fingerprint(), [], True, False, False)
+  before = cp.to_dict()
+  assert cp.radarUnavailable and cp.openpilotLongitudinalControl
+  assert not DPathRadarD(cp).controller.retain_confirmed_near_front
+  assert cp.to_dict() == before
+
+
+def test_default_off_actual_outputs_equal_original_controller():
+  """원형 controller 파일을 그대로 실행하여 모드별 600회 전체 출력의 같음을 확인한다."""
+  from dataclasses import asdict
+  source = Path(__file__).resolve().parents[4] / 'native_sim/baseline_build/controller.py'
+  spec = importlib.util.spec_from_file_location('ars_validation_original_controller', source)
+  original = importlib.util.module_from_spec(spec)
+  sys.modules[spec.name] = original
+  spec.loader.exec_module(original)
+  for mode in (-2, -1, 0, 1, 2, 3):
+    before = original.DPathRadarController(production_live_tracks=True, enable_radar_tracks=mode)
+    after = DPathRadarController(production_live_tracks=True, enable_radar_tracks=mode)
+    for index in range(100):
+      distance = 10. - .1 * index if index < 90 else .49
+      source_name = ('frontRadar', 'scc', 'corner235')[index // 30 % 3]
+      observed = point(distance, radarSource=source_name)
+      inputs = {"time_s": 10. + index * .05, "v_ego": .2, "radar_points": [observed], "model": model(distance)}
+      assert asdict(before.update(**inputs)) == asdict(after.update(**inputs))
