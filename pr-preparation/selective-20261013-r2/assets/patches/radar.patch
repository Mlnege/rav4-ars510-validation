+class Ars510RadarInterface(RadarInterfaceBase):
+  """원형 fused 결과를 실제 Carrot RadarData와 MyTrack 처리에 연결한다."""
+
+  ARS510_INPUT_RECOVERY_API = 1
+
+  def __init__(self, CP):
